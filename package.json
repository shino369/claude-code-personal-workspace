{
  "name": "kyoten",
  "version": "0.1.0",
  "private": true,
  "description": "kyoten (拠点): a home base for coding agents (Claude Code, Codex, DeepSeek) with shared rules, tasks, memory, skills, hooks, and quality gates",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shino369/kyoten.git"
  },
  "type": "module",
  "imports": {
    "#utils/*": "./utils/*"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test --pass-with-no-tests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,yaml,yml}\"",
    "skills:check": "node utils/skills-check.js",
    "skills:install": "node utils/skills-install.js",
    "skills:update": "pnpm dlx skills update -y",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:coverage",
    "skills:link": "node utils/skills-link.js",
    "workspace:setup": "node utils/workspace-setup.js",
    "workspace:check": "node utils/workspace-setup.js --check",
    "task": "node utils/task/cli.js",
    "memory": "node utils/memory/cli.js",
    "loop": "node utils/loop/cli.js",
    "swarm": "node utils/swarm/cli.js",
    "agent": "node utils/agent/cli.js",
    "tools": "node utils/tools/cli.js",
    "harness": "node utils/harness/cli.js",
    "kyoten": "node utils/kyoten/cli.js",
    "kyoten:pack": "node utils/kyoten/pack.js"
  },
  "keywords": [],
  "author": "shino369",
  "license": "ISC",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12.14.0"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "devDependencies": {
    "@playwright/test": "catalog:dev",
    "@types/chrome": "catalog:dev",
    "@types/node": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "@vitest/ui": "catalog:dev",
    "agent-browser": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-config-prettier": "catalog:dev",
    "globals": "catalog:dev",
    "playwright": "catalog:dev",
    "prettier": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
