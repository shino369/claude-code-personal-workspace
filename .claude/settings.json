{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(pnpm *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(python *)",
      "Bash(node *)",
      "Bash(ls *)",
      "Bash(dir *)",
      "Bash(cd *)",
      "Bash(pwd)",
      "Bash(echo *)",
      "Bash(cat *)",
      "Bash(type *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(rm *)",
      "Bash(del *)",
      "Bash(rmdir *)",
      "Bash(move *)",
      "Bash(mv *)",
      "Bash(copy *)",
      "Bash(cp *)",
      "Bash(pnpm install *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Edit(/package.json)",
      "Edit(/tsconfig.json)",
      "Edit(/.gitignore)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Edit(//\\\\*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/credentials.json)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(//C:/Windows/**)",
      "Read(//C:/Program Files/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)",
      "Edit(./**/credentials.json)",
      "Edit(./**/*.pem)",
      "Edit(./**/*.key)",
      "Bash(npm *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(Invoke-WebRequest *)",
      "Bash(iwr *)",
      "Bash(Invoke-RestMethod *)",
      "Bash(irm *)",
      "Bash(powershell *)",
      "Bash(pwsh *)",
      "Bash(cmd *)",
      "Bash(net *)",
      "Bash(netsh *)",
      "Bash(reg *)",
      "Bash(regedit *)",
      "Bash(sc *)",
      "Bash(schtasks *)",
      "Bash(wmic *)",
      "Bash(format *)",
      "Bash(diskpart *)",
      "Bash(shutdown *)",
      "Bash(restart *)",
      "Bash(taskkill *)"
    ],
    "additionalDirectories": []
  },
  "attribution": {
    "commit": "🤖 Generated with Claude Code\n\nCo-Authored-By: Claude Sonnet 4.5 <noreply@anthropic.com>",
    "pr": "🤖 Generated with [Claude Code](https://claude.com/claude-code)"
  },
  "respectGitignore": true,
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1"
  },
  "companyAnnouncements": [
    "Welcome! This workspace organizes outputs in output/tasks/YYYYMMDD_task_name/"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/audit_logger.js",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/auto_format.js",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
