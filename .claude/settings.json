{
  "cleanupPeriodDays": 30,
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(pnpm *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(python *)",
      "Bash(node *)",
      "Bash(ls *)",
      "Bash(dir *)",
      "Bash(cd *)",
      "Bash(pwd)",
      "Bash(echo *)",
      "Bash(cat *)",
      "Bash(type *)",
      "Bash(curl *)",
      "Bash(mkdir *)"
    ],
    "ask": [
      "Bash(kill -9:*)",
      "Bash(pkill:*)",
      "Bash(killall:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git cherry-pick:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/credentials.json)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(//C:/Windows/**)",
      "Read(//C:/Program Files/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)",
      "Edit(./**/credentials.json)",
      "Edit(./**/*.pem)",
      "Edit(./**/*.key)",
      "Bash(npm *)",
      "Bash(wget *)",
      "Bash(Invoke-WebRequest *)",
      "Bash(iwr *)",
      "Bash(Invoke-RestMethod *)",
      "Bash(irm *)",
      "Bash(powershell *)",
      "Bash(pwsh *)",
      "Bash(cmd *)",
      "Bash(net *)",
      "Bash(netsh *)",
      "Bash(reg *)",
      "Bash(regedit *)",
      "Bash(sc *)",
      "Bash(schtasks *)",
      "Bash(wmic *)",
      "Bash(format *)",
      "Bash(diskpart *)",
      "Bash(shutdown *)",
      "Bash(restart *)",
      "Bash(taskkill *)",
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(dd:*)",
      "Bash(mount:*)",
      "Bash(umount:*)",
      "Bash(systemctl:*)",
      "Bash(mkfs:*)",
      "Bash(fdisk:*)",
      "Bash(parted:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git branch -D:*)",
      "Bash(git tag -d:*)",
      "Bash(pnpm publish:*)"
    ],
    "additionalDirectories": []
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "respectGitignore": true,
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "DISABLE_AUTO_COMPACT": "1"
  },
  "companyAnnouncements": [
    "Welcome! This workspace organizes outputs in output/tasks/YYYYMMDD_task_name/"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/context_monitor.js",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/audit_logger.js",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/auto_format.js",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
