# kyoten dscc profile: DeepSeek settings for Claude Code.
# Format: KEY=value, one per line. '#' starts a comment. Values are literal:
# no quoting, no variable expansion; the file is parsed, never executed.
# Reference: https://api-docs.deepseek.com/quick_start/agent_integrations/claude_code/
#
# The API key stays empty until you run: kyoten dscc --set-key
# Get one at https://platform.deepseek.com/api_keys
#
# Safe to edit by hand. `kyoten dscc --show` prints it with the key masked.

ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=

# Model mapping. DeepSeek resolves the `claude-sonnet` / `claude-opus` aliases
# through these, so a `"model": "sonnet"` setting still lands on deepseek-flash.
ANTHROPIC_MODEL=deepseek-flash[1m]
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-flash[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-flash[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-flash
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-flash

CLAUDE_CODE_EFFORT_LEVEL=max
CLAUDE_CODE_AUTO_COMPACT_WINDOW=786432
