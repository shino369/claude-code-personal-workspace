{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "*.js",
    "*.mjs",
    "*.ts",
    "utils/**/*",
    "e2e/**/*",
    ".claude/hooks/**/*",
    ".claude/workflows/__tests__/**/*",
    ".agents/skills/context-manager/**/*",
    ".agents/skills/dependency-update/**/*",
    ".agents/skills/document-writing/**/*",
    ".agents/skills/engineering-terminology/**/*",
    ".agents/skills/security-update/**/*",
    ".agents/skills/translation-expertise/**/*",
    ".agents/skills/web-browsing/**/*",
    ".agents/skills/workspace-setup/**/*"
  ],
  "exclude": ["node_modules", "**/node_modules", "coverage", "dist", "build"]
}
