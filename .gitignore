# Claude Code Workspace - .gitignore

# ============================================
# Task Directory
# ============================================
# Task outputs generated by Claude Code
tasks/

# ============================================
# Environment Variables & Secrets
# ============================================
.env
.env.*
!.env.example
secrets/
*.pem
*.key
credentials.json
*.crt
*.p12
*.pfx

# ============================================
# Node.js & pnpm
# ============================================
# Dependencies
node_modules/
.pnp/
.pnp.js

# pnpm specific
.pnpm-debug.log*
# Machine-local tool registry (pnpm tools); tools/catalog.json is committed
tools/local.json

# Local store pnpm creates when a sandboxed agent (codex, dsh workspace-write) cannot reach the global one
.pnpm-store/

# Yarn (if accidentally used)
yarn.lock
yarn-error.log

# npm (if accidentally used)
package-lock.json
npm-debug.log*

# ============================================
# Build Outputs
# ============================================
dist/
build/
out/
*.tsbuildinfo
.next/
.nuxt/
.cache/

# ============================================
# Logs
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================
# OS Specific
# ============================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory
.Trash-*

# ============================================
# IDE & Editors
# ============================================
# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
Session.vim

# Emacs
*~
\#*\#
.\#*

# ============================================
# Testing
# ============================================
coverage/
test-results/
playwright-report/
blob-report/
.nyc_output/
*.lcov
.coverage
htmlcov/
.pytest_cache/
.tox/

# ============================================
# Temporary Files
# ============================================
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup
*.old

# ============================================
# Claude Code Specific
# ============================================
# Local Claude Code settings (keep shared settings)
.claude/settings.local.json

# Claude Code cache/temp files
.claude/.cache/
.claude/tmp/

# ============================================
# Python (if used)
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
env/
.venv/
pip-log.txt

# ============================================
# TypeScript
# ============================================
*.tsbuildinfo

# ============================================
# Miscellaneous
# ============================================
# Backup files
*~
*.orig
*.rej

# Archive files
# *.zip
# *.tar
# *.tar.gz
# *.rar
# *.7z

# Database files
*.sqlite
*.sqlite3
*.db

# Compiled source
*.com
*.class
*.dll
*.exe
*.o
*.so

# ============================================
# Project Specific Excludes
# ============================================
# Local MCP configuration (copy .mcp.json.example to .mcp.json)
/.mcp.json

# Local aliases for GitHub agent discovery
/.github/skills

# Local resources
/resources

# Personal memory (pnpm memory): machine-local notes, personalization, and
# the generated core block. Never commit; pnpm workspace:check fails if tracked.
/AGENTS.local.md
/CLAUDE.local.md
/memory/

# Skills live in .agents/skills/ (the skills.sh layout, read directly by Codex
# and other agents). Project-owned skills are tracked; third-party skills from
# skills.sh stay local. Keep this list in sync with OWNED_SKILLS in
# utils/workspace-config.js.
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/context-manager/
!/.agents/skills/dependency-update/
!/.agents/skills/document-writing/
!/.agents/skills/engineering-terminology/
!/.agents/skills/security-update/
!/.agents/skills/translation-expertise/
!/.agents/skills/transparent-background/
!/.agents/skills/web-browsing/
!/.agents/skills/workspace-setup/

# .claude/skills/ only holds links into .agents/skills/ (pnpm workspace:setup)
/.claude/skills/
