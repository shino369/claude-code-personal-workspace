# Claude Code Workspace - .gitignore

# ============================================
# Task Directory
# ============================================
# Task outputs generated by Claude Code
tasks/

# ============================================
# Environment Variables & Secrets
# ============================================
.env
.env.*
!.env.example
secrets/
*.pem
*.key
credentials.json
*.crt
*.p12
*.pfx

# ============================================
# Node.js & pnpm
# ============================================
# Dependencies
node_modules/
.pnp/
.pnp.js

# pnpm specific
.pnpm-debug.log*

# Yarn (if accidentally used)
yarn.lock
yarn-error.log

# npm (if accidentally used)
package-lock.json
npm-debug.log*

# ============================================
# Build Outputs
# ============================================
dist/
build/
out/
*.tsbuildinfo
.next/
.nuxt/
.cache/

# ============================================
# Logs
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================
# OS Specific
# ============================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory
.Trash-*

# ============================================
# IDE & Editors
# ============================================
# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
Session.vim

# Emacs
*~
\#*\#
.\#*

# ============================================
# Testing
# ============================================
coverage/
test-results/
playwright-report/
blob-report/
.nyc_output/
*.lcov
.coverage
htmlcov/
.pytest_cache/
.tox/

# ============================================
# Temporary Files
# ============================================
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup
*.old

# ============================================
# Claude Code Specific
# ============================================
# Local Claude Code settings (keep shared settings)
.claude/settings.local.json

# Claude Code cache/temp files
.claude/.cache/
.claude/tmp/

# ============================================
# Python (if used)
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
env/
.venv/
pip-log.txt

# ============================================
# TypeScript
# ============================================
*.tsbuildinfo

# ============================================
# Miscellaneous
# ============================================
# Backup files
*~
*.orig
*.rej

# Archive files
# *.zip
# *.tar
# *.tar.gz
# *.rar
# *.7z

# Database files
*.sqlite
*.sqlite3
*.db

# Compiled source
*.com
*.class
*.dll
*.exe
*.o
*.so

# ============================================
# Project Specific Excludes
# ============================================
# Local MCP configuration (copy .mcp.json.example to .mcp.json)
/.mcp.json

# Global skill-manager state; the project lockfile is skills-lock.json
/.agents/.skill-lock.json

# Local aliases for GitHub agent discovery
/.github/skills

# Local resources
/resources

# Project-owned skills are tracked in .claude/skills/. Third-party skill
# contents are tracked in .agents/skills/; the .claude/skills entries for them
# are machine-specific discovery aliases recreated by skills.sh.
/.claude/skills/*
!/.claude/skills/context-manager/
!/.claude/skills/dependency-update/
!/.claude/skills/document-writing/
!/.claude/skills/engineering-terminology/
!/.claude/skills/security-update/
!/.claude/skills/translation-expertise/
